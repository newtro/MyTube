# Copy to .env and fill in. .env is gitignored; never commit real values.

# Postgres — shared VM cluster via SSH tunnel:  ssh -N -L 5433:localhost:5432 vm
DATABASE_URL=postgresql://mytube:CHANGE_ME@localhost:5433/mytube

# YouTube Data API v3 key (public data: videos.list). See docs/runbooks/phase0-setup.md
YOUTUBE_API_KEY=

# OpenRouter (embeddings + LLM), one key for both
OPENROUTER_API_KEY=

# OAuth desktop client secret file downloaded from Google Cloud console
OAUTH_CLIENT_SECRETS=var/oauth_client_secret.json

# Shorts hard-filter threshold in seconds (owner requirement, AC-3/AC-18)
SHORTS_MAX_SECONDS=180

# Comma-separated model ids benchmarked in Phase 0 (>=2 required for the gate)
EMBEDDING_MODELS=openai/text-embedding-3-small,qwen/qwen3-embedding-8b

# The Phase-0 gate winner — REQUIRED before Phase 1+ (scoring/steering embed
# against this model). Leave empty only while running the benchmark itself.
EMBEDDING_MODEL_OF_RECORD=

# ---- Phase 2: web app -------------------------------------------------------
# Web OAuth client (Google Cloud console, type "Web application"; redirect
# URIs: <PUBLIC_BASE_URL>/api/auth/callback and /api/connect/callback)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Comma-separated allowlisted Google emails. The FIRST one is the owner —
# only it can adopt the CLI-imported history on first sign-in.
ALLOWED_EMAILS=

# Absolute base URL of the deployed app (https://mytube.<domain>);
# http://localhost:8123 for local development only
PUBLIC_BASE_URL=http://localhost:8123

# Fernet key(s), comma-separated (first = encrypt, all = decrypt; rotate by
# prepending a new key). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# DEV ONLY — auto-signs-in as the owner and disables CSRF; the app refuses
# to start with this on unless PUBLIC_BASE_URL is localhost
DEV_FAKE_USER=false

# ---- Phase 3: discovery engines ---------------------------------------------
# Trending chart categories to poll daily (comma-separated YouTube category
# ids, e.g. 28=Science&Tech, 10=Music). EMPTY = trending stays OFF — this is
# an owner decision (plan §17); FLOW-25 idles until set.
TRENDING_CATEGORIES=
TRENDING_REGION=US

# Chat model for query bootstrap + NL steering (OpenRouter id)
LLM_MODEL=openai/gpt-5-mini

# ---- Phase 4: steering + promise-vs-delivery (defaults are sensible) --------
# STEERING_TTL_DAYS=7          directive lifetime
# STEERING_WEIGHT=1.5          pseudo-taste-term multiplier in the kNN
# OVERPROMISE_PENALTY_WEIGHT=0.15  rules-layer penalty per overpromise point
